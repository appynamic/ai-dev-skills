{
	"journal": {
		"PreInvocation": [{ "type": "command", "command": "node skills/journal/scripts/journal.mjs prompt --agent antigravity", "timeout": 30 }],
		"Stop": [{ "type": "command", "command": "node skills/journal/scripts/journal.mjs stop --agent antigravity", "timeout": 30 }],
		"PreToolUse": [{ "matcher": "run_command", "hooks": [{ "type": "command", "command": "node skills/journal/scripts/journal.mjs precommit --agent antigravity", "timeout": 30 }] }]
	}
